<?xml version="1.0" encoding="utf-8"?>
<!--
     the splash for Android 8 to 11, which have no system splash screen:
     the launch window's background, drawn before any code runs. The icon's
     own foreground on the app's charcoal, so the first frame is the icon and
     not a blank dark window. Android 12 and later use values-v31 instead.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/rb_bg" />
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
