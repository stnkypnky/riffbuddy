<?xml version="1.0" encoding="utf-8"?>
<!--
     Variation A of the icon brief: an original body-and-neck silhouette on a
     diagonal, with the pickup cut clean through as negative space (the spec).
     The outline is a plain shape of its own, not a trace of any manufacturer's
     body or headstock.

     The body is two overlapping bouts, which is what gives it a waist; a single
     ellipse read as a banjo. Both bouts are wound the same way so they union
     under the default non-zero fill, and the pickup is wound the other way,
     which punches it through. A real hole rather than a charcoal-colored patch
     matters here: launchers parallax the foreground against the background, and
     a patch would drift off whatever it was meant to be hiding.

     Every mark is inside the 66-unit safe zone, so no launcher mask can clip it.
     The master is icon/variation-a-body.svg on the same 108-unit grid, so the
     path data in the two files is identical.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="guitar"
        android:rotation="-35"
        android:pivotX="54"
        android:pivotY="54.25">

        <path android:pathData="M47.5,25 h13 v7 h-3.5 v26 h-6 v-26 h-3.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="47.5" android:startY="25"
                    android:endX="47.5" android:endY="58">
                    <item android:offset="0.0" android:color="#FFFFC24A" />
                    <item android:offset="1.0" android:color="#FFEFA52C" />
                </gradient>
            </aapt:attr>
        </path>

        <path android:pathData="M41.5,63 a12.5,9 0 1,0 25,0 a12.5,9 0 1,0 -25,0 Z M39,74 a15,9.5 0 1,0 30,0 a15,9.5 0 1,0 -30,0 Z M47,58 h14 a1.5,1.5 0 0 1 1.5,1.5 v2 a1.5,1.5 0 0 1 -1.5,1.5 h-14 a1.5,1.5 0 0 1 -1.5,-1.5 v-2 a1.5,1.5 0 0 1 1.5,-1.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="83.5">
                    <item android:offset="0.0" android:color="#FFF7B23C" />
                    <item android:offset="1.0" android:color="#FFE08A00" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
