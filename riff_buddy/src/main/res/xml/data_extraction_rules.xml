<?xml version="1.0" encoding="utf-8"?>
<!--
     Belt and braces alongside allowBackup="false": if a future Android release
     or an OEM backs the app up anyway, the practice log and the API keys still
     do not leave the device. The export file is the only way data travels,
     and the player chooses where it goes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
